{
  "name": "@partssource/react-kit",
  "version": "0.1.0",
  "description": "PartsSource Design System — React + TypeScript component kit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./tokens.css",
    "./colors.css": "./colors_and_type.css",
    "./tailwind.config": "./tailwind.config.js",
    "./tokens": "./src/tokens.ts"
  },
  "files": [
    "dist",
    "src",
    "tailwind.config.js",
    "tailwind-input.css",
    "tokens.css",
    "colors_and_type.css",
    "tokens.ts",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotTheVeal/react-ui-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "npm run sync:browser && vite",
    "prebuild": "npm run test",
    "build": "npm run lint && npm run sync:browser && vite build && tsc --emitDeclarationOnly --outDir dist",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind-input.css -o tailwind.css --minify",
    "sync:browser": "node scripts/sync-to-browser.mjs",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "clean": "rm -rf dist storybook-static",
    "build:tokens": "node scripts/build-tokens.mjs",
    "test:tokens": "node scripts/token-gate.mjs",
    "export:tokens": "node scripts/figma-export-tokens.mjs",
    "export:tokens:dry": "node scripts/figma-export-tokens.mjs --dry-run",
    "test:export": "node scripts/figma-export-tokens.mjs --self-test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.9",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/addon-links": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@storybook/react-vite": "^8.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "storybook": "^8.3.0",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "3.4.16",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "partssource",
    "ui-kit"
  ],
  "license": "UNLICENSED"
}
